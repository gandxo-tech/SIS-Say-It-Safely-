rules_version = '2';

// Règles alignées sur le schéma de l'application SIS :
//   users/{uid}            profil privé (email inclus), visible par son propriétaire seulement
//   usernames/{username}   annuaire public : pseudo -> uid (+ photo). Un pseudo pris est définitif.
//   messages/{id}          { to, message, createdAt } : écriture anonyme, lecture par le propriétaire du pseudo
service cloud.firestore {
  match /databases/{database}/documents {

    // Même format que l'inscription : minuscules, chiffres, underscore, 3 à 20 caractères
    function isValidUsername(u) {
      return u is string && u.matches('^[a-z0-9_]{3,20}$');
    }

    // Pseudos réservés (anti-usurpation)
    function isReserved(u) {
      return u in ['admin', 'administrateur', 'sis', 'support', 'moderateur',
                   'officiel', 'official', 'root', 'system', 'null', 'undefined'];
    }

    // Seules les images hébergées sur le Cloudinary de SIS sont acceptées comme photo
    function isValidPhoto(u) {
      return u is string && u.size() <= 300
        && u.matches('^https://res\\.cloudinary\\.com/duddyzckz/image/upload/.+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------- Annuaire public des pseudos ----------
    match /usernames/{username} {
      // Lecture d'un pseudo précis (existence + photo), jamais de listing
      allow get: if true;
      allow list: if false;

      // create échoue si le document existe déjà : un pseudo pris est définitif
      allow create: if isSignedIn()
        && isValidUsername(username)
        && !isReserved(username)
        && request.resource.data.keys().hasOnly(['uid', 'createdAt', 'photoURL'])
        && request.resource.data.keys().hasAll(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt is string
        && (!('photoURL' in request.resource.data) || isValidPhoto(request.resource.data.photoURL))
        // Un compte = un pseudo : le profil users/{uid} doit être écrit dans le même lot
        // (ou exister déjà avec ce même pseudo)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('username', username) == username;

      // Le propriétaire ne peut changer que sa photo
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoURL'])
        && (!('photoURL' in request.resource.data) || isValidPhoto(request.resource.data.photoURL));

      // Un compte peut se supprimer : le propriétaire retire son pseudo de l'annuaire
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ---------- Profil privé ----------
    match /users/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if false;

      // Le profil naît avec son pseudo réservé (même lot) et au bon propriétaire
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && isValidUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Le pseudo et l'identifiant ne changent jamais (les anciens profils sans ces champs restent modifiables)
      allow update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.get('uid', uid) == uid
        && (!('username' in resource.data) || request.resource.data.username == resource.data.username);

      // Suppression de compte : le propriétaire efface son profil
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Messages anonymes ----------
    match /messages/{messageId} {

      // Envoi : sans compte, sans identifiant d'expéditeur, vers un pseudo existant
      allow create: if request.resource.data.keys().hasOnly(['to', 'message', 'createdAt'])
        && isValidUsername(request.resource.data.to)
        && exists(/databases/$(database)/documents/usernames/$(request.resource.data.to))
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000
        // L'horodatage est posé par le serveur, pas par le client
        && request.resource.data.createdAt == request.time;

      // Lecture et suppression : uniquement le propriétaire du pseudo destinataire
      allow get, list, delete: if isSignedIn()
        && get(/databases/$(database)/documents/usernames/$(resource.data.to)).data.uid == request.auth.uid;

      allow update: if false;
    }

    // ---------- Classement public (compteurs de messages reçus) ----------
    match /leaderboard/{username} {
      allow get, list: if true;

      allow create: if isValidUsername(username)
        && !isReserved(username)
        && existsAfter(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['username', 'photoURL', 'messageCount', 'countryCode', 'updatedAt'])
        && request.resource.data.username == username
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.updatedAt is string
        && (!('countryCode' in request.resource.data) || request.resource.data.countryCode.matches('^[A-Z]{2}$'))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == '' || isValidPhoto(request.resource.data.photoURL))
        && (
          (isSignedIn() && getAfter(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid)
          || (request.resource.data.messageCount == 1 && !('photoURL' in request.resource.data))
        );

      allow update: if isValidUsername(username)
        && exists(/databases/$(database)/documents/usernames/$(username))
        && request.resource.data.keys().hasOnly(['username', 'photoURL', 'messageCount', 'countryCode', 'updatedAt'])
        && request.resource.data.username == username
        && request.resource.data.messageCount is int
        && request.resource.data.messageCount >= 0
        && request.resource.data.updatedAt is string
        && (!('countryCode' in request.resource.data) || request.resource.data.countryCode.matches('^[A-Z]{2}$'))
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL == '' || isValidPhoto(request.resource.data.photoURL))
        && (
          (isSignedIn() && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['messageCount', 'updatedAt'])
            && request.resource.data.messageCount == resource.data.messageCount + 1
          )
        );

      // Suppression de compte : le propriétaire efface son entrée publique
      allow delete: if isSignedIn()
        && exists(/databases/$(database)/documents/usernames/$(username))
        && get(/databases/$(database)/documents/usernames/$(username)).data.uid == request.auth.uid;
    }

    // Tout le reste est refusé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
